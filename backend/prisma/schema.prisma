// Database: PostgreSQL (Supabase) for both local dev and production.
//
// Portability legacy: this schema was written provider-agnostic (no enums, no
// provider-specific types; JSON stored as String; role-like fields are strings
// validated in application code). Those constraints are kept so the schema stays
// simple, but the target is now Postgres only. The connection URL comes from
// DATABASE_URL via prisma.config.ts (migrations) and the pg driver adapter (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Identity is owned by Supabase Auth (auth.users). This row mirrors the Supabase
// user so the app's data can foreign-key to it: `id` is the Supabase auth uid,
// provisioned just-in-time on the user's first authenticated request. No
// password/token/oauth columns — Supabase manages credentials and sessions.
model User {
  id              String   @id // = Supabase auth uid (uuid)
  email           String   @unique
  displayName     String?
  avatarUrl       String? // small base64 data URL (resized client-side) or a hosted image URL
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Manual tier lever for the prototype. When set, this WINS over the billing
  // subscription — it is how a tier gets granted without anyone paying Stripe.
  //   'unlimited' -> full Pro, no quota (what existing alpha users are given)
  //   'pro'       -> full Pro, no quota
  //   'free'      -> forced onto free limits even if a subscription exists
  //   null        -> normal behaviour: the Stripe subscription decides
  // Deliberately a plain nullable string, not an enum: the schema is enum-free
  // for portability, and this is validated in lib/entitlements.ts.
  planOverride    String?
  // Why the override was granted, so a row is auditable a month from now
  // ("alpha grandfather", "demo day judge", "refund goodwill").
  planOverrideNote String?

  // Data Privacy Act (RA 10173) records consent as a "freely given, specific,
  // informed indication" evidenced by written/electronic means. Storing the
  // moment and the version accepted is that evidence — a bare boolean would
  // not tell us WHICH terms they agreed to once the terms change.
  termsAcceptedAt      DateTime?
  termsAcceptedVersion String?
  settings        UserSettings?
  subscription    Subscription?
  meetings        Meeting[]
  reviews         Review[]
  practiceSessions PracticeSession[]
  progressMetrics ProgressMetric[]
}

// Billing state mirrored from the payment provider. Provider-agnostic on
// purpose: `provider` + generic customerId/subscriptionId mean adding PayMongo
// or GCash for PH users is a new service module, not a schema change.
//
// The provider is the source of truth; this row is a cache kept current by
// webhooks so the app can answer "what plan is this user on?" without a network
// call. Never write prices here — amounts live in the provider's dashboard.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("stripe") // 'stripe' | 'paymongo' (future)

  // Provider-side ids. customerId outlives any single subscription, so it is
  // kept even after a cancellation — re-subscribing reuses the same customer.
  customerId     String?
  subscriptionId String? @unique

  // Raw provider status, e.g. Stripe's 'trialing' | 'active' | 'past_due' |
  // 'canceled' | 'unpaid' | 'incomplete'. Interpreted in lib/entitlements.ts —
  // never compared to string literals elsewhere in the app.
  status String @default("free")

  priceId          String? // which configured price they bought (not the amount)
  interval         String? // 'month' | 'year'
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  trialEndsAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Meeting {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  durationSeconds Int
  platform        String // 'web' | 'desktop'
  transcript      String // "VA:"/"Client:"-labeled lines

  // Timestamped transcript: JSON array of { t, speaker, text } where `t` is
  // milliseconds from the call start. The live session already tracks this per
  // line (it sorts by it) and used to throw it away when flattening to the
  // labeled string above — this keeps it so the post-call view can show when
  // each line was said.
  //
  // Additive on purpose. `transcript` stays the source of truth for the AI
  // prompts and for every meeting recorded before this column existed; when
  // this is null the UI simply renders the transcript without timestamps.
  transcriptJson  String?

  createdAt       DateTime @default(now())
  review          Review?

  @@index([userId, startedAt])
}

model Review {
  id            String   @id @default(cuid())
  meetingId     String   @unique
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallScore  Int
  insightsJson  String // JSON as String: Prisma has no Json type on SQLite
  exercisesJson String
  scoresJson    String
  // Per-dimension "why did I score this" breakdown: { confidence: { reason,
  // evidence[], improve }, ... }. Nullable because reviews generated before
  // this existed have none, and because a model may omit it — the UI shows the
  // score without a breakdown in that case rather than erroring.
  scoreDetailsJson String?
  metricsJson   String
  createdAt     DateTime @default(now())
  practiceSessions PracticeSession[]
}

model PracticeSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId         String?
  review           Review?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  title            String
  scenario         String
  targetSkillsJson String
  difficulty       Int // 1-5
  status           String    @default("active") // 'active' | 'completed'
  summaryJson      String?
  createdAt        DateTime  @default(now())
  endedAt          DateTime?
  turns            PracticeTurn[]
}

model PracticeTurn {
  id           String          @id @default(cuid())
  sessionId    String
  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String // 'client' | 'va'
  text         String
  feedbackJson String?
  createdAt    DateTime        @default(now())
}

model ProgressMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String // 'call' | 'practice'
  refId     String // meetingId or practiceSessionId
  dimension String // 'overall' | 'confidence' | 'clarity' | ...
  value     Float
  createdAt DateTime @default(now())

  @@index([userId, dimension, createdAt])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Days conversation transcripts are kept before the cleanup job deletes them.
  // Reviews and progress metrics are never auto-deleted.
  transcriptRetentionDays Int @default(30)

  // Seconds of post-client-turn silence before a Lifeline fires (Phase 2).
  lifelinePauseSeconds Float @default(1.5)

  // JSON as String (SQLite): { emailReviewReady?: boolean, emailPracticeReminders?: boolean }
  notificationPrefsJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
